    // 2. Función para renderizar los partidos de la jornada seleccionada
    function cargarJornada(numeroJornada) {
      const container = document.getElementById('matchesContainer');
      const partidos = datosJornadas[numeroJornada];

      // Cambiar clase 'active' en las pestañas
      const botones = document.querySelectorAll('.tab-btn');
      botones.forEach((btn, index) => {
        if (index + 1 === numeroJornada) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // Generar el HTML de las tarjetas
      let html = '';
      partidos.forEach(partido => {
        html += `
          <div class="match-card">
            <div class="match-date">${partido.fecha}</div>
            <div class="match-teams">
              <div class="team home">
                <span>${partido.local}</span>
                <div class="team-badge">${partido.badgeLocal}</div>
              </div>
              <div class="score">${partido.marcador}</div>
              <div class="team away">
                <div class="team-badge">${partido.badgeVisitante}</div>
                <span>${partido.visitante}</span>
              </div>
            </div>
            <div class="match-location">📍 ${partido.cancha}</div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    // Cargar la Jornada 1 por defecto al iniciar
    cargarJornada(1);
